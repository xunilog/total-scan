{
  "nodeModulesDir": "manual",
  "tasks": {
    "check": "deno fmt --check . && deno lint . && deno check",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "desktop": "rm -rf release && deno desktop -A .",
    "desktop:dev": "rm -rf release && deno desktop -A --hmr .",
    "watcher": "deno run -A watcher/main.ts",
    "watcher:test": "deno test watcher/",
    "watcher:check": "deno fmt --check watcher/ && deno lint watcher/ && deno check watcher/"
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ]
    }
  },
  "exclude": [
    "dist",
    "release"
  ],
  "imports": {
    "@/": "./",
    "@std/assert": "jsr:@std/assert@^1.0.13",
    "@std/http/file-server": "jsr:@std/http@^1.1.3/file-server",
    "@types/node": "npm:@types/node@^22",
    "@mantine/core": "npm:@mantine/core@^9.6.1",
    "@mantine/hooks": "npm:@mantine/hooks@^9.6.1",
    "@types/react": "npm:@types/react@^19.3.0",
    "@types/react-dom": "npm:@types/react-dom@^19.3.0",
    "@vitejs/plugin-react": "npm:@vitejs/plugin-react@^6.1.1",
    "postcss": "npm:postcss@^8.5.28",
    "postcss-preset-mantine": "npm:postcss-preset-mantine@^1.18.0",
    "postcss-simple-vars": "npm:postcss-simple-vars@^7.0.1",
    "react": "npm:react@^19.3.0",
    "react-dom": "npm:react-dom@^19.3.0",
    "react-dom/client": "npm:react-dom@^19.3.0/client",
    "react-icons": "npm:react-icons@^5.5.0",
    "vite": "npm:vite@^8.3.0"
  },
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.asynciterable",
      "dom.iterable",
      "deno.ns"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "types": [
      "vite/client"
    ]
  },
  "desktop": {
    "app": {
      "name": "Scan Carburant",
      "identifier": "com.scancarburant.app",
      "icons": {
        "macos": "./static/app-icon.png"
      }
    },
    "output": {
      "macos": "./release/ScanCarburant"
    }
  }
}
